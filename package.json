{
  "name": "search-keywords",
  "version": "2.0.0",
  "private": true,
  "description": "Search Console / Bing CLI: long-tail queries, sitemap index status, multi-property export",
  "packageManager": "pnpm@11.4.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "auth": "node auth.mjs",
    "long-tail": "node long-tail.mjs",
